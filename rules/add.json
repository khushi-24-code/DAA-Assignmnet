              "#include <stdio.h>",
              "",
              "/* Function to find the sum of two numbers */",
              "int sumOfTwo(int x, int y)",
              "{",
              "    int result = x + y;",
              "    return result;",
              "}",
              "",
              "int main()",
              "{",
