{
  "problem": "add_two_integers",
  "statement": "Read two integers on a single line separated by whitespace and print their sum followed by a newline.",
  "input_spec": "{int} {int}",
  "reference": [
    "/* Reference solution for add_two_integers.",
    " * The sum is computed in 64 bits, so every pair of 32-bit inputs —",
    " * including INT_MAX + 1 and INT_MIN - 1 — gets its true sum. */",
    "#include <stdio.h>",
    "",
    "static long long add(long long lhs, long long rhs) {",
    "    return lhs + rhs;",
    "}",
    "",
    "int main(void) {",
    "    long long lhs, rhs;",
    "    if (scanf(\"%lld %lld\", &lhs, &rhs) != 2) {",
    "        return 1;",
    "    }",
    "    printf(\"%lld\\n\", add(lhs, rhs));",
    "    return 0;",
    "}"
  ],
  "time_limit_s": 1,
  "memory_limit_mb": 64,
  "seed": 42,
  "metrics": [
    {
      "name": "correctness",
      "analyzer": "io_tests",
      "weight": 0.2,
      "params": {
