          {
            "input": "2147483647 1\n",
            "output": "2147483648\n"
          },
          {
            "input": "  42\t  8  \n",
            "output": "50\n"
          },
          {
            "input": "-2147483648 -1\n",
            "output": "-2147483649\n"
